#!/bin/sh
# Blocks direct pushes to protected branches (ED-18, ED-27). Changes reach develop and
# master only through pull requests merged on GitHub, which this hook does not affect.
# Enable once per clone:  git config core.hooksPath .githooks
# Emergency bypass:       git push --no-verify

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/develop|refs/heads/master)
      echo "✋ Direct pushes to '${remote_ref#refs/heads/}' are not allowed. Push a feature branch and open a pull request." >&2
      status=1
      ;;
  esac
done

exit $status
